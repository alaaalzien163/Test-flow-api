# ---------------------------------------------------------------------------
# TaskFlow API - Docker Compose environment variables (EXAMPLE)
#
# Copy this file to `.env.docker` and adjust the values:
#   copy .env.docker.example .env.docker
#
# `.env.docker` is git-ignored and is NOT copied into the Docker image.
# These variables are loaded by Docker Compose via `env_file:`.
# ---------------------------------------------------------------------------

# --- PostgreSQL container ---------------------------------------------------
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-local-dev-password

# --- API + migrations -------------------------------------------------------
# IMPORTANT: the host MUST be the Compose service name `postgres`, not localhost.
# Replace <password> with the same value as POSTGRES_PASSWORD above.
DATABASE_URL="postgresql://taskflow:change-me-local-dev-password@postgres:5432/taskflow?schema=public"

NODE_ENV=production
PORT=3000

# Use a long random value (>= 16 chars). Never commit a real secret.
JWT_SECRET="change-me-to-a-long-random-secret-min-16-chars"
JWT_EXPIRES_IN=1h

CORS_ORIGIN=*

# Rate limiting (per client IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
