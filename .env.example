# ---------------------------------------------------------------------------
# TaskFlow API - local development environment
# Copy this file to `.env` and adjust values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# JWT signing secret. Use a long, random value (>= 32 chars) outside development.
JWT_SECRET="dev-only-super-secret-change-me-0123456789abcdef"
JWT_EXPIRES_IN="1h"

# CORS allowed origin(s). Use "*" for local development or a comma separated list.
CORS_ORIGIN="*"

# Rate limiting (per client IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
